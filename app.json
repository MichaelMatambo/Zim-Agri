{
  "expo": {
    "name": "ZimAgri Farmer",
    "slug": "zimagri-farmer",
    "version": "1.0.0",
    "scheme": "zimagri",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "newArchEnabled": false,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "zw.ac.uz.zimagri",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Used to tag your listings and run spatial analyses for your farm.",
        "NSCameraUsageDescription": "Take photos of your produce for listings.",
        "NSPhotoLibraryUsageDescription": "Choose produce photos for listings."
      }
    },
    "android": {
      "package": "zw.ac.uz.zimagri",
      "softwareKeyboardLayoutMode": "resize",
      "permissions": [
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO"
      ],
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#1B8A3E"
      },
      "versionCode": 1
    },
    "plugins": [
      "expo-router",
      [
        "expo-image-picker",
        {
          "cameraPermission": "Take photos of your produce."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": false
    },
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#1B8A3E"
    },
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "cd813797-b39a-4bb8-9550-c1b846e73904"
      }
    },
    "owner": "michaelmatambo"
  }
}
